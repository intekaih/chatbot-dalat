# ========================================
# OPTION 1: OpenAI API Direct
# ========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# ========================================
# OPTION 2: API Proxy (Custom Domain) - RECOMMENDED
# ========================================
# Truy cập từ mọi IP/môi trường. Đổi KEY thành key của bạn.
API_PROXY_BASE_URL=https://api.intekaih.id.vn/v1
API_PROXY_KEY=sk-your-proxy-key-here
API_PROXY_MODEL=gemini-3-flash
API_IMAGE_MODEL=gemini-3.1-flash-image

# Available models from Antigravity Tools:
# - gemini-3-flash (Fast & Cheap)
# - gemini-3-pro-high (High Quality)
# - gemini-3-pro-low (Medium Quality)
# - gemini-2.5-flash
# - claude-4.5-sonnet
# - claude-4.5-opus

# ========================================
# IMAGES - AI Generated (No external API needed)
# ========================================
# Tất cả ảnh địa điểm được tạo bởi AI và lưu tại:
# ionic-tailwind-app/src/assets/places/
# Được phục vụ qua Firebase Hosting: https://dalat-chatbot.web.app/assets/places/
# Không cần cấu hình thêm gì cả.
