# ========================================
# OPTION 1: OpenAI API Direct
# ========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# ========================================
# OPTION 2: API Proxy (Antigravity Tools)
# ========================================
# Uncomment and configure these if using API Proxy instead of direct OpenAI
# API_PROXY_BASE_URL=http://123.0.0.1:8080/v1
# API_PROXY_KEY=k_edr07aakrohmshduabkehovaO00P
# API_PROXY_MODEL=gemini-3-flash

# Available models from Antigravity Tools:
# - gemini-3-flash (Fast & Cheap)
# - gemini-3-pro-high (High Quality)
# - gemini-3-pro-low (Medium Quality)
# - gemini-2.5-flash
# - claude-4.5-sonnet
# - claude-4.5-opus

# ========================================
# PEXELS API - For Dynamic Images
# ========================================
# Get your API Key from: https://www.pexels.com/api/
# 1. Create an account
# 2. Go to "Your Account" -> "API"
# 3. Copy the API Key
PEXELS_API_KEY=your-pexels-api-key-here
