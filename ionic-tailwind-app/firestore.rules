rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles - only owner can read/write
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Favorites - only owner can access
    match /favorites/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Trips - only owner can access
    match /trips/{tripId} {
      allow read, write: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow create: if request.auth != null;
    }
    
    // Chat sessions - only owner can access
    match /chat_sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow create: if request.auth != null;
    }
    
    // Places - anyone can read, only admin can write
    match /places/{placeId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Reviews - anyone can read
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
  }
}
