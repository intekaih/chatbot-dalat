rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ────────────────────────────────────────────────
    // Chỉ chủ tài khoản mới đọc/ghi được profile của mình
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ── Chat sessions (sub-collection) ──────────────────────────────
      // Path: users/{uid}/chatSessions/{sessionId}
      match /chatSessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Messages (sub-sub-collection)
        // Path: users/{uid}/chatSessions/{sessionId}/messages/{messageId}
        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // ── Trips (sub-collection) ───────────────────────────────────────
      // Path: users/{uid}/trips/{tripId}
      match /trips/{tripId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Favorites (sub-collection) ───────────────────────────────────
      // Path: users/{uid}/favorites/{placeId}
      match /favorites/{placeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Places — public read, admin-only write ────────────────────────
    match /places/{placeId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // ── Categories — public read only ─────────────────────────────────
    match /categories/{catId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // ── Reviews — public read, authenticated write ───────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }
  }
}
